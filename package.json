{
  "name": "dsh-profile-stylist",
  "version": "0.1.0",
  "description": "Say what kind of profile you want; the agent writes it and puts it up. Generates nickname/bio/taglines with the host model, picks or composes an avatar from local assets, then fills the profile page and uploads the picture - dry-run by default.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./constants": "./lib/constants.js",
    "./author": "./lib/author.js",
    "./hosts": "./lib/hosts.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "profile",
    "avatar",
    "bio",
    "nickname",
    "persona",
    "account",
    "github",
    "gitee",
    "branding",
    "个人资料",
    "头像",
    "简介"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7gzgn/dsh-profile-stylist.git"
  },
  "homepage": "https://github.com/7gzgn/dsh-profile-stylist#readme",
  "bugs": {
    "url": "https://github.com/7gzgn/dsh-profile-stylist/issues"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
